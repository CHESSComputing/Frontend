<style>
  .code-wrapper {
    position: relative;
    display: block;
  }
  .code-wrapper pre {
    padding-right: 40px; /* Prevents long text from overlapping the icon */
  }
  .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: #ffffff;
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 4px 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #333;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .copy-btn:hover {
    background: #f0f0f0;
    border-color: #999;
  }
</style>

<div class="record">
  <h3>Access token</h3>
  <div class="code-wrapper">
    <pre id="access-token-pre">{{.Token}}</pre>
    <button type="button" class="copy-btn" onclick="copyPreContent('access-token-pre', this)" title="Copy to clipboard" aria-label="Copy access token">
      <!-- Copy SVG Icon -->
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
    </button>
  </div>

  To obtain write token click
  <a href="{{.Base}}/token?scope=write" class="button button-small">here</a>

  <h4>Expires</h4>
  {{.Expires}}

  {{if ne .TokenData ""}}
  <h3>Token data</h3>
  <div class="code-wrapper">
    <pre id="token-data-pre">{{.TokenData}}</pre>
    <button type="button" class="copy-btn" onclick="copyPreContent('token-data-pre', this)" title="Copy to clipboard" aria-label="Copy token data">
      <!-- Copy SVG Icon -->
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
    </button>
  </div>
  {{end}}
</div>

<script>
  function copyPreContent(elementId, btn) {
    const text = document.getElementById(elementId).innerText;

    navigator.clipboard.writeText(text).then(() => {
      const originalHtml = btn.innerHTML;
      // Swap to a green checkmark icon for 1.5 seconds as visual feedback
      btn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>`;

      setTimeout(() => {
        btn.innerHTML = originalHtml;
      }, 1500);
    }).catch(err => {
      console.error('Failed to copy text: ', err);
    });
  }
</script>
