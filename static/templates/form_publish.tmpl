<section>
  <article id="article">
<div class="center huge">
     FOXDEN: Publish dataset
</div>


<form action="{{.Base}}/publish" method="post" name="did_publish" id="did_publish" class="form">
    <div class="form-item">
        <label class="hint hint-req">Dataset (&#42;)</label>
        <input class="input" type="text" value="{{.Did}}" id="did" name="did">
        <input class="input" type="hidden" value="{{.Schema}}" id="schema" name="schema">
    </div>
    <div class="form-item">
        <label class="hint hint-req">Publication Service (&#42;)</label>
        <select class="input" id="doiprovider" name="doiprovider">
            <option value="DataCite">DataCite</option>
            <option value="MaterialsCommons">MaterialsCommons</option>
            <option value="Zenodo">Zenodo</option>
        </select>
    </div>
    <div class="form-item">
      <label class="hint hint-req">Data reuse license (&#42;)</label>
      <select class="input" id="license" name="license">
          <option value="CC-BY-4.0" selected>
              Creative Commons Attribution 4.0 (CC BY 4.0)
          </option>
          <option value="CC0-1.0">
              Creative Commons Zero 1.0 (CC0)
          </option>
          <option value="CC-BY-SA-4.0">
              Creative Commons Attribution-ShareAlike 4.0
          </option>
          <option value="CC-BY-NC-4.0">
              Creative Commons Attribution-NonCommercial 4.0
          </option>
          <option value="CC-BY-ND-4.0">
              Creative Commons Attribution-NoDerivatives 4.0
          </option>
          <option value="ODC-By-1.0">
              Open Data Commons Attribution (ODC-By)
          </option>
          <option value="ODbL-1.0">
              Open Database License (ODbL)
          </option>
          <option value="PDDL-1.0">
              Public Domain Dedication and License (PDDL)
          </option>
      </select>
      <small class="hint">
          Specifies how others may reuse this published dataset.
      </small>
    </div>
    <div class="form-item hide">
        <label class="hint hint-req">Project name (please use chess_ prefix to avoid overlap with other MC projects) (&#42;)</label>
        <input class="input" type="text" value="{{.MCProjectName}}" id="mcprojectname" name="mcprojectname">
    </div>
    <div class="form-item alert alert-info">
        <input type="checkbox" checked="checked" id="draft" name="draft">
        <span>Create draft DOI</span>
        &nbsp; | &nbsp;
        <input type="checkbox" checked="" id="publishmetadata" name="publishmetadata">
        <span>Publish meta-data</span>
{{if .Parents}}
        <h3>Parent Datasets</h3>
        <label>
            <input type="checkbox" id="select-all" onclick="toggleAll(this)">
            <strong>Select All</strong>
        </label>
        <ul class="parent-list">
            {{range .Parents}}
            <li>
                <label>
                    <input type="checkbox" class="parent-checkbox" name="parents" value="{{.}}">
                    {{.}}
                </label>
            </li>
            {{end}}
        </ul>
{{else}}
    <p><em>No parents found for this dataset.</em></p>
{{end}}
    </div>
{{if .Members}}
    <div class="form-item alert alert-info">
        <h4>{{.GroupKey}}: {{.Group}}</h4>
        You may select appropriate members of this {{.GroupKey}} for your publication
        <label>
            <input type="checkbox" id="select-all" onclick="toggleAll(this)">
            <strong>Select All</strong>
        </label>
        <ul class="parent-list">
            {{range .Members}}
            <li>
                <label>
                    <input type="checkbox" class="parent-checkbox" name="authors" value="{{.}}">
                    {{.}}
                </label>
            </li>
            {{end}}
        </ul>
    </div>
{{end}}
    <div class="form-item">
        <label class="hint hint-req">Dataset description (&#42;)</label>
        <textarea class="input" rows="3" id="description" name="description"></textarea>
    </div>
    <div class="form-item">
        <button class="button button-small button-dark">Publish</button>
        <button class="button button-small">Cancel</button>
    </div>
</form>

  </article>
</section>

<script>
function toggleAll(source) {
    const checkboxes = document.querySelectorAll('.parent-checkbox');
    for (const cb of checkboxes) {
        cb.checked = source.checked;
    }
}

(function () {

  function toggleProjectName() {
    const provider = document.getElementById("doiprovider");
    const project = document.getElementById("mcprojectname")?.closest(".form-item");

    if (!provider || !project) return;

    if (provider.value === "MaterialsCommons") {
      project.classList.remove("hide");
    } else {
      project.classList.add("hide");
    }
  }

  // Run once on page load
  document.addEventListener("DOMContentLoaded", toggleProjectName);

  // React to user changes
  document.addEventListener("change", function (e) {
    if (e.target?.id === "doiprovider") {
      toggleProjectName();
    }
  });

})();

</script>
