<section>
<article id="article" class="wide">

<div id="graph">
  <div style="flex:1 1 auto; display:flex; flex-direction:column;">
    <div id="legend"></div>
    <div id="controls">
      Click a node for details. Double-click a node to collapse/expand its descendants.
      <button onclick="cy.fit()">Fit graph</button>
    </div>
    <div id="cy"></div>
  </div>
  <div id="sidebar">
    <p style="font-size:13px;color:#888;">Select a record to see its full JSON.</p>
  </div>
</div>

</article>
</section>

<script>
    // Elements are injected server-side by the Go handler as
    // {"nodes":[{"data":{"id","label","group","details"}}], "edges":[...]}
    const elements = {{.ElementsJSON}};

    // Deterministic color per "group" (schema name) so the same
    // schema always gets the same color across page loads.
    const palette = ['#7F77DD', '#1D9E75', '#D85A30', '#D4537E', '#378ADD', '#EF9F27', '#639922'];
    const groups = [...new Set(elements.nodes.map(n => n.data.group))];
    const colorFor = {};
    groups.forEach((g, i) => colorFor[g] = palette[i % palette.length]);

    const legend = document.getElementById('legend');
    groups.forEach(g => {
      const span = document.createElement('span');
      span.className = 'legend-item';
      span.innerHTML = '<span class="legend-dot" style="background:' + colorFor[g] + '"></span>' + g;
      legend.appendChild(span);
    });

    const cy = cytoscape({
      container: document.getElementById('cy'),
      elements: elements,
      style: [
        {
          selector: 'node',
          style: {
            'label': 'data(label)',
            'background-color': ele => colorFor[ele.data('group')] || '#999',
            'color': '#fff',
            'text-valign': 'center',
            'text-halign': 'center',
            'font-size': 9,
            'text-wrap': 'wrap',
            'text-max-width': '80px',
            'width': 90,
            'height': 32,
            'shape': 'ellipse'
          }
        },
        {
          selector: 'edge',
          style: {
            'width': 1,
            'line-color': '#ccc',
            'target-arrow-color': '#ccc',
            'target-arrow-shape': 'triangle',
            'curve-style': 'bezier'
          }
        },
        {
          selector: '.hidden',
          style: { 'display': 'none' }
        }
      ],
      layout: { name: 'dagre', rankDir: 'TB', nodeSep: 24, rankSep: 44 }
    });

    // Click a node -> show its full record JSON in the sidebar.
    cy.on('tap', 'node', evt => {
      const d = evt.target.data();
      document.getElementById('sidebar').innerHTML =
        '<h2>' + d.group + '</h2>' +
        '<div class="did">' + d.id + '</div>' +
        '<pre>' + JSON.stringify(d.details, null, 2) + '</pre>';
    });

    // Double-click a node -> collapse/expand its descendant subtree.
    cy.on('dbltap', 'node', evt => {
      const node = evt.target;
      const descendants = node.successors('node');
      if (descendants.length === 0) return;
      const nowHidden = !descendants.hasClass('hidden');
      descendants.toggleClass('hidden', nowHidden);
      descendants.connectedEdges().toggleClass('hidden', nowHidden);
      cy.layout({ name: 'dagre', rankDir: 'TB', nodeSep: 24, rankSep: 44 }).run();
    });

</script>
