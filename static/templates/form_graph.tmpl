<section>
<article id="article">
<div id="graph">
  <div id="graph-top">
    <div id="legend"></div>
    <div id="controls">
      Click a node or green provenance arrow for details. Double-click a node to collapse/expand.
      <button onclick="cy.fit()">Fit graph</button>
    </div>
    <div id="cy"></div>
  </div>
  <div id="details">
    <p style="font-size:14px;color:#888;">Select a record to see its details.</p>
  </div>
</div>
</article>
</section>

<script>
function isProvOrSpec(n) {
  const g = (n.data.group || '').toLowerCase();
  return g.startsWith('provenance') || g.startsWith('specscans');
}

const elements = {{.ElementsJSON}};

elements.nodes = elements.nodes || [];
elements.edges = elements.edges || [];

elements.edges = elements.edges.filter(e => e && e.data && e.data.source && e.data.target);
elements.nodes = elements.nodes.filter(n => n && n.data && n.data.id);

const nodeById = new Map(elements.nodes.map(n => [n.data.id, n]));

const lineageTargets = new Set(
  elements.edges
    .filter(e => {
      const src = nodeById.get(e.data.source);
      return src && !isProvOrSpec(src);
    })
    .map(e => e.data.target)
);

const rootNodes = elements.nodes.filter(
  n => !isProvOrSpec(n) && !lineageTargets.has(n.data.id)
);

// Create plain grey origin edges
rootNodes.forEach((n, i) => {
  const startId = '__start__' + i;
  elements.nodes.push({ data: { id: startId, label: '', group: 'start' } });
  elements.edges.push({
    data: { id: startId + '-edge', source: startId, target: n.data.id }
  });
});

const palette = ['#7F77DD', '#1D9E75', '#D85A30', '#D4537E', '#378ADD', '#EF9F27', '#639922'];

const prefixColors = [
  { prefix: 'metadata',   color: '#7F77DD' },
  { prefix: 'provenance', color: '#1D9E75' },
  { prefix: 'specscans',  color: '#EF9F27' },
  { prefix: 'doi',        color: '#D85A30' },
  { prefix: 'composite',  color: '#D4537E' },
  { prefix: 'user',       color: '#378ADD' },
];

const groups = [...new Set(elements.nodes.map(n => n.data.group))];
const fallbackColorFor = {};
groups.forEach((g, i) => fallbackColorFor[g] = palette[i % palette.length]);

function colorForNode(d) {
  const label = (d.label || '').toLowerCase();
  const match = prefixColors.find(p => label.startsWith(p.prefix));
  if (match) return match.color;
  return fallbackColorFor[d.group] || '#999';
}

const legendEntries = [];
const seenLabels = new Set();
elements.nodes.forEach(n => {
  if (n.data.group === 'start') return;
  const label = (n.data.label || '').toLowerCase();
  const match = prefixColors.find(p => label.startsWith(p.prefix));
  const key = match ? match.prefix : n.data.group;
  if (!seenLabels.has(key)) {
    seenLabels.add(key);
    legendEntries.push({ name: key, color: match ? match.color : fallbackColorFor[n.data.group] });
  }
});

const hasProvEdges = elements.edges.some(e => e.data && e.data.prov);
if (hasProvEdges && !seenLabels.has('provenance')) {
  seenLabels.add('provenance');
  legendEntries.push({ name: 'provenance', color: '#1D9E75' });
}

const legend = document.getElementById('legend');
legendEntries.forEach(e => {
  const span = document.createElement('span');
  span.className = 'legend-item';
  span.innerHTML = '<span class="legend-dot" style="background:' + e.color + '"></span>' + e.name;
  legend.appendChild(span);
});

// Compact horizontal distance with expanded vertical separation
const dagreLayoutOptions = {
  name: 'dagre',
  rankDir: 'LR',
  nodeSep: 130,                        // Vertical distance (height of the triangle)
  rankSep: 85,                         // Horizontal distance (prevents graph from stretching wide)
  nodeDimensionsIncludeLabels: true,  // Accounts for text bounds in node layout
  spacingFactor: 1.0,                  // Keeps viewport scaling at 1:1
  fit: true,
  padding: 25
};

const cy = cytoscape({
  container: document.getElementById('cy'),
  elements: elements,
  style: [
    {
      selector: 'node',
      style: {
        'label': 'data(label)',
        'background-color': ele => colorForNode(ele.data()),
        'color': '#fff',
        'text-valign': 'center',
        'text-halign': 'center',
        'font-size': 13,                // Clear, legible typography
        'font-weight': '600',
        'text-wrap': 'wrap',
        'text-max-width': '140px',
        'width': 160,                   // Large explicit node width
        'height': 52,                   // Large explicit node height
        'shape': 'round-rectangle',
        'padding': '6px'
      }
    },
    {
      selector: 'node[group = "start"]',
      style: {
        shape: 'ellipse',
        width: 22,
        height: 22,
        label: '',
        'background-color': '#111'
      }
    },
    {
      selector: 'edge',
      style: {
        'width': 1.5,
        'line-color': '#ccc',
        'target-arrow-color': '#ccc',
        'target-arrow-shape': 'triangle',
        'curve-style': 'bezier'
      }
    },
    {
      selector: 'edge[?prov]',
      style: {
        'width': 3.5,
        'line-color': '#1D9E75',
        'target-arrow-color': '#1D9E75',
        'target-arrow-shape': 'triangle',
        'curve-style': 'bezier'
      }
    },
    {
      selector: '.hidden',
      style: { 'display': 'none' }
    }
  ],
  layout: dagreLayoutOptions
});

cy.on('dbltap', 'node', evt => {
  const node = evt.target;
  const descendants = node.successors('node');
  if (descendants.length === 0) return;
  const nowHidden = !descendants.hasClass('hidden');
  descendants.toggleClass('hidden', nowHidden);
  descendants.connectedEdges().toggleClass('hidden', nowHidden);
  cy.layout(dagreLayoutOptions).run();
});

function fetchDetails(rawId) {
  const segments = rawId.split('/').filter(Boolean);
  const apiPrefix = '/' + segments[0].split('-')[0];
  const did = '/' + segments.slice(1).join('/');

  const details = document.getElementById('details');
  details.innerHTML = '<p style="font-size:14px;color:#888;">Loading…</p>';

  fetch(apiPrefix + '?ajaxHtml=true&did=' + encodeURIComponent(did))
    .then(resp => {
      if (!resp.ok) throw new Error('status ' + resp.status);
      return resp.text();
    })
    .then(html => { details.innerHTML = html; })
    .catch(err => {
      details.innerHTML = '<p style="font-size:14px;color:#c0392b;">Failed to load record: ' + err.message + '</p>';
    });
}

cy.on('tap', 'node', evt => {
  const nodeid = evt.target.data('id');
  if (nodeid.startsWith('__start__')) return;
  fetchDetails(nodeid);
});

// Displays explicit provenance info message upon clicking green provenance edges
cy.on('tap', 'edge', evt => {
  const edge = evt.target;
  if (edge.data('prov')) {
    const details = document.getElementById('details');
    details.innerHTML = '<p style="font-size:14px;color:#333;line-height:1.5;">' +
      'The provenance information of the metadata record is available through the record itself. ' +
      'Just click on corresponding metadata record box and choose <b>Provenance</b> button.</p>';
  }
});
</script>
